{
  "manifest_version": 3,
  "name": "On This Day",
  "version": "1.1",
  "description": "Daily historical events (randomized)",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon16.png",
      "128": "icon16.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon16.png",
    "128": "icon16.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.wikimedia.org/*"
  ]
}
